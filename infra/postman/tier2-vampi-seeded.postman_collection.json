{
  "info": {
    "name": "Tier-2 vampi-seeded (A1 stateful-authz)",
    "description": "THESIS-seeded fork of erev0s/VAmPI. VULNERABLE on :5002 (default baseUrl), FIXED on :5003 (statefulrolecheck=1). Users: admin/pass1 (ADMIN victim), superadmin/pass1 (ADMIN operator), name1/pass1, name2/pass2 (non-admin). Login POST /users/v1/login returns {\"auth_token\":...}; sent as Authorization: Bearer <token>. Reseed with GET /createdb before a run. Seeded endpoints: transition PUT /users/v1/{username}/role {\"role\":\"user\"|\"admin\"}; guard PUT /books/v1/{book_title}/secret {\"secret\":...}. Run the 'A1 bug demo' folder top-to-bottom: on :5002 the last PUT returns 200 (bug); on :5003 it returns 403.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5002" },
    { "key": "token", "value": "" },
    { "key": "victimToken", "value": "" },
    { "key": "operatorToken", "value": "" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "GET /createdb (reseed)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/createdb", "host": ["{{baseUrl}}"], "path": ["createdb"] },
            "description": "Recreates the database and reseeds users and books. Call before every run."
          }
        },
        {
          "name": "GET / (home)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /users/v1/login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "if (j && j.auth_token) { pm.collectionVariables.set('token', j.auth_token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"username\":\"admin\",\"password\":\"pass1\"}" },
            "url": { "raw": "{{baseUrl}}/users/v1/login", "host": ["{{baseUrl}}"], "path": ["users", "v1", "login"] },
            "description": "Stores auth_token into {{token}}."
          }
        },
        {
          "name": "POST /users/v1/login (superadmin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "if (j && j.auth_token) { pm.collectionVariables.set('token', j.auth_token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"username\":\"superadmin\",\"password\":\"pass1\"}" },
            "url": { "raw": "{{baseUrl}}/users/v1/login", "host": ["{{baseUrl}}"], "path": ["users", "v1", "login"] }
          }
        },
        {
          "name": "POST /users/v1/register",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"username\":\"name3\",\"password\":\"pass3\",\"email\":\"name3@example.com\"}" },
            "url": { "raw": "{{baseUrl}}/users/v1/register", "host": ["{{baseUrl}}"], "path": ["users", "v1", "register"] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "GET /users/v1 (all users)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/users/v1", "host": ["{{baseUrl}}"], "path": ["users", "v1"] }
          }
        },
        {
          "name": "GET /users/v1/_debug",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/users/v1/_debug", "host": ["{{baseUrl}}"], "path": ["users", "v1", "_debug"] }
          }
        },
        {
          "name": "GET /users/v1/{username}",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/users/v1/admin", "host": ["{{baseUrl}}"], "path": ["users", "v1", "admin"] }
          }
        },
        {
          "name": "PUT /users/v1/{username}/role (transition, seeded)",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "body": { "mode": "raw", "raw": "{\"role\":\"user\"}" },
            "url": { "raw": "{{baseUrl}}/users/v1/admin/role", "host": ["{{baseUrl}}"], "path": ["users", "v1", "admin", "role"] },
            "description": "ADMIN only. role is admin or user (lowercase). The permission-reducing transition."
          }
        },
        {
          "name": "DELETE /users/v1/{username} (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/users/v1/name1", "host": ["{{baseUrl}}"], "path": ["users", "v1", "name1"] }
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "GET /books/v1",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/books/v1", "host": ["{{baseUrl}}"], "path": ["books", "v1"] }
          }
        },
        {
          "name": "POST /books/v1 (add book)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "body": { "mode": "raw", "raw": "{\"book_title\":\"bookTitleX\",\"secret\":\"my secret\"}" },
            "url": { "raw": "{{baseUrl}}/books/v1", "host": ["{{baseUrl}}"], "path": ["books", "v1"] }
          }
        },
        {
          "name": "GET /books/v1/{book_title}",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/books/v1/bookTitle1", "host": ["{{baseUrl}}"], "path": ["books", "v1", "bookTitle1"] }
          }
        },
        {
          "name": "PUT /books/v1/{book_title}/secret (guard, seeded)",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "body": { "mode": "raw", "raw": "{\"secret\":\"updated secret\"}" },
            "url": { "raw": "{{baseUrl}}/books/v1/bookTitle1/secret", "host": ["{{baseUrl}}"], "path": ["books", "v1", "bookTitle1", "secret"] },
            "description": "ADMIN only (non-admin -> 403). Repeatable on the same book, so the follow-up can replay it. The guarded, non-consuming write."
          }
        }
      ]
    },
    {
      "name": "A1 bug demo (970 triple)",
      "description": "Run top to bottom. victim = admin, operator = superadmin. VULNERABLE (:5002): step 6 returns 200. FIXED (:5003): step 6 returns 403.",
      "item": [
        {
          "name": "1. GET /createdb (reseed)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/createdb", "host": ["{{baseUrl}}"], "path": ["createdb"] }
          }
        },
        {
          "name": "2. login admin (victim token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "if (j && j.auth_token) { pm.collectionVariables.set('victimToken', j.auth_token); }",
                  "pm.test('login 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"username\":\"admin\",\"password\":\"pass1\"}" },
            "url": { "raw": "{{baseUrl}}/users/v1/login", "host": ["{{baseUrl}}"], "path": ["users", "v1", "login"] }
          }
        },
        {
          "name": "3. login superadmin (operator token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "if (j && j.auth_token) { pm.collectionVariables.set('operatorToken', j.auth_token); }",
                  "pm.test('login 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"username\":\"superadmin\",\"password\":\"pass1\"}" },
            "url": { "raw": "{{baseUrl}}/users/v1/login", "host": ["{{baseUrl}}"], "path": ["users", "v1", "login"] }
          }
        },
        {
          "name": "4. source: PUT secret with victim token (expect 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [ "pm.test('source ALLOWED 200', function () { pm.response.to.have.status(200); });" ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{victimToken}}" } ],
            "body": { "mode": "raw", "raw": "{\"secret\":\"s1\"}" },
            "url": { "raw": "{{baseUrl}}/books/v1/bookTitle1/secret", "host": ["{{baseUrl}}"], "path": ["books", "v1", "bookTitle1", "secret"] }
          }
        },
        {
          "name": "5. transition: demote admin with operator token (expect 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [ "pm.test('transition 200', function () { pm.response.to.have.status(200); });" ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{operatorToken}}" } ],
            "body": { "mode": "raw", "raw": "{\"role\":\"user\"}" },
            "url": { "raw": "{{baseUrl}}/users/v1/admin/role", "host": ["{{baseUrl}}"], "path": ["users", "v1", "admin", "role"] }
          }
        },
        {
          "name": "6. follow-up: PUT secret with stale victim token (vuln 200 / fixed 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('follow-up status', function () {",
                  "  pm.expect([200, 403]).to.include(pm.response.code);",
                  "});",
                  "console.log('follow-up code = ' + pm.response.code + ' (200 = BUG A1, 403 = fixed)');"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{victimToken}}" } ],
            "body": { "mode": "raw", "raw": "{\"secret\":\"s2\"}" },
            "url": { "raw": "{{baseUrl}}/books/v1/bookTitle1/secret", "host": ["{{baseUrl}}"], "path": ["books", "v1", "bookTitle1", "secret"] },
            "description": "Reuses admin's pre-transition token. On VULNERABLE it still writes (200); on FIXED it is denied (403)."
          }
        }
      ]
    }
  ]
}
