{
  "info": {
    "name": "Tier-1 reports-api (A1 stateful-authz)",
    "description": "Controlled target for the thesis. VULNERABLE on :8080 (default baseUrl), PATCHED on :8081 (set app.security.stateful-role-check=true). Seeded users: alice/alicepass (ADMIN victim), superadmin/superpass (ADMIN stable), bob/bobpass (VIEWER). Reports ids 1..5. Login POST /auth/login returns {\"token\":...}; sent as Authorization: Bearer <token>. Run the 'A1 bug demo' folder top-to-bottom: on :8080 the last DELETE returns 204 (bug); on :8081 it returns 403.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth & reset",
      "item": [
        {
          "name": "POST /reset (reseed)",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/reset", "host": ["{{baseUrl}}"], "path": ["reset"] },
            "description": "Public. Reseeds users and reports 1..5 to the initial state. Expect 200."
          }
        },
        {
          "name": "POST /auth/login (alice ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "if (j && j.token) { pm.collectionVariables.set('token', j.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"username\":\"alice\",\"password\":\"alicepass\"}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Stores the JWT into the collection variable {{token}}. Expect 200."
          }
        },
        {
          "name": "POST /auth/login (superadmin ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "if (j && j.token) { pm.collectionVariables.set('token', j.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"username\":\"superadmin\",\"password\":\"superpass\"}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "POST /auth/login (bob VIEWER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "if (j && j.token) { pm.collectionVariables.set('token', j.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"username\":\"bob\",\"password\":\"bobpass\"}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "GET /users/me",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] },
            "description": "Returns the caller identity for the current {{token}}."
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "GET /reports",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/reports", "host": ["{{baseUrl}}"], "path": ["reports"] },
            "description": "Any authenticated user. Expect 200."
          }
        },
        {
          "name": "GET /reports/1",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/reports/1", "host": ["{{baseUrl}}"], "path": ["reports", "1"] }
          }
        },
        {
          "name": "POST /reports (ADMIN)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "body": { "mode": "raw", "raw": "{\"title\":\"New report\",\"classification\":\"PUBLIC\"}" },
            "url": { "raw": "{{baseUrl}}/reports", "host": ["{{baseUrl}}"], "path": ["reports"] },
            "description": "classification is PUBLIC or CONFIDENTIAL. ADMIN 201, VIEWER 403, invalid body 400."
          }
        },
        {
          "name": "PUT /reports/1 (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "body": { "mode": "raw", "raw": "{\"title\":\"Edited report\",\"classification\":\"CONFIDENTIAL\"}" },
            "url": { "raw": "{{baseUrl}}/reports/1", "host": ["{{baseUrl}}"], "path": ["reports", "1"] }
          }
        },
        {
          "name": "DELETE /reports/1 (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/reports/1", "host": ["{{baseUrl}}"], "path": ["reports", "1"] },
            "description": "ADMIN 204, VIEWER 403 (authorize before existence: a demoted user deleting a missing id still gets 403)."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "PUT /users/alice/role (transition)",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "body": { "mode": "raw", "raw": "{\"role\":\"VIEWER\"}" },
            "url": { "raw": "{{baseUrl}}/users/alice/role", "host": ["{{baseUrl}}"], "path": ["users", "alice", "role"] },
            "description": "ADMIN only. role is ADMIN or VIEWER (uppercase; lowercase viewer returns 400). This is the permission-reducing transition."
          }
        }
      ]
    },
    {
      "name": "A1 bug demo (970 triple)",
      "description": "Run top to bottom with the collection runner. VULNERABLE (:8080): step 5 returns 204. PATCHED (:8081): step 5 returns 403.",
      "item": [
        {
          "name": "1. POST /reset",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/reset", "host": ["{{baseUrl}}"], "path": ["reset"] }
          }
        },
        {
          "name": "2. login alice (capture token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "if (j && j.token) { pm.collectionVariables.set('token', j.token); }",
                  "pm.test('login 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"username\":\"alice\",\"password\":\"alicepass\"}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "3. source: DELETE /reports/1 (expect 204)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [ "pm.test('source ALLOWED 204', function () { pm.response.to.have.status(204); });" ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/reports/1", "host": ["{{baseUrl}}"], "path": ["reports", "1"] }
          }
        },
        {
          "name": "4. transition: PUT /users/alice/role VIEWER (expect 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [ "pm.test('transition 200', function () { pm.response.to.have.status(200); });" ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "body": { "mode": "raw", "raw": "{\"role\":\"VIEWER\"}" },
            "url": { "raw": "{{baseUrl}}/users/alice/role", "host": ["{{baseUrl}}"], "path": ["users", "alice", "role"] }
          }
        },
        {
          "name": "5. follow-up: DELETE /reports/2 with stale token (vuln 204 / patched 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('follow-up status', function () {",
                  "  pm.expect([204, 403]).to.include(pm.response.code);",
                  "});",
                  "console.log('follow-up code = ' + pm.response.code + ' (204 = BUG A1, 403 = patched)');"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/reports/2", "host": ["{{baseUrl}}"], "path": ["reports", "2"] },
            "description": "Reuses alice's pre-transition token. On VULNERABLE this still deletes (204); on PATCHED it is denied (403)."
          }
        }
      ]
    }
  ]
}
