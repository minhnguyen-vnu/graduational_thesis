    {
      "name": "A1 bug demo (970 triple)",
      "description": "FIXED variant (http://localhost:5003). Run top to bottom. The last step must return 403.",
      "item": [
        {
          "name": "1. GET /createdb (reseed)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/createdb",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "createdb"
              ]
            }
          }
        },
        {
          "name": "2. login admin (victim token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "if (j && j.auth_token) { pm.collectionVariables.set('victimToken', j.auth_token); }",
                  "pm.test('login 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"admin\",\"password\":\"pass1\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/v1/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "v1",
                "login"
              ]
            }
          }
        },
        {
          "name": "3. login superadmin (operator token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "if (j && j.auth_token) { pm.collectionVariables.set('operatorToken', j.auth_token); }",
                  "pm.test('login 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"superadmin\",\"password\":\"pass1\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/v1/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "v1",
                "login"
              ]
            }
          }
        },
        {
          "name": "4. source: PUT secret with victim token (expect 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('source ALLOWED 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{victimToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"secret\":\"s1\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/books/v1/bookTitle1/secret",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "v1",
                "bookTitle1",
                "secret"
              ]
            }
          }
        },
        {
          "name": "5. transition: demote admin with operator token (expect 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('transition 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{operatorToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"role\":\"user\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/v1/admin/role",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "v1",
                "admin",
                "role"
              ]
            }
          }
        },
        {
          "name": "6. follow-up: PUT secret with stale victim token (fixed: expect 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('follow-up DENIED 403', function () { pm.response.to.have.status(403); });",
                  "console.log('follow-up code = ' + pm.response.code + ' (expected 403 on FIXED; 200 would mean the patch is not active)');"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{victimToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"secret\":\"s2\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/books/v1/bookTitle1/secret",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "v1",
                "bookTitle1",
                "secret"
              ]
            },
            "description": "Reuses admin's pre-transition token. On VULNERABLE it still writes (200); on FIXED it is denied (403)."
          }
        }
      ]
