            "url": {
              "raw": "{{baseUrl}}/books/v1/bookTitle1/secret",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "v1",
                "bookTitle1",
                "secret"
              ]
            },
            "description": "ADMIN only (non-admin -> 403). Repeatable on the same book, so the follow-up can replay it. The guarded, non-consuming write."
          }
        }
      ]
    },
