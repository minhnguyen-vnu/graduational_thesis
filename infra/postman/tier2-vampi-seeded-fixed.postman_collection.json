            "url": {
              "raw": "{{baseUrl}}/users/v1/admin/role",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "v1",
                "admin",
                "role"
              ]
            },
            "description": "ADMIN only. role is admin or user (lowercase). The permission-reducing transition."
          }
