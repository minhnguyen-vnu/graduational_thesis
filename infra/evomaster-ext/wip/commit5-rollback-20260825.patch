+            .ifEmpty { guardedCandidatesFor(listOf(HttpVerb.POST)) }
+
+        // Prefer what looks most like an admin-only action: the FEWER distinct users were ever allowed
+        // on it, the more restricted it is, with ties broken by how many were denied. This is only a
+        // heuristic over black-box evidence, and it changes the ORDER candidates are tried in, never
+        // which are eligible -- so it can make a run find a triple sooner, never find a different one.
+        // Applied in declared mode only, so every measurement taken without a declared transition is
+        // unaffected; evaluating it on the inferred path is future work.
+        val ordered = if (declared == null) candidates else candidates.sortedWith(
+            compareBy(
+                { distinctUsersOn(it.first, it.second.path, statusGroup = StatusGroup.G_2xx) },
+                { -distinctUsersOn(it.first, it.second.path, status = 403) }
+            )
+        )
+
+        for ((verb, op) in ordered) {
+            run {
+
+                if (hasPhaseTimedOut()) return
+
+                // Every distinct user seen ALLOWED (2xx) on this guarded action is a victim candidate,
+                // smallest test first. One candidate is not enough. A triple is VOID (§5.3) -- not a
+                // result -- when the victim's credential no longer works (401: the fuzzer may well
+                // have deleted the account during the search), when the privilege was already gone
+                // (403, which aborts the black-box test at its first action), or when the transition
+                // did not take effect (403 by an operator who is not privileged either). Each of those
+                // is answered by trying the NEXT candidate: that is what "void and retry" means, and
+                // without it a single unlucky pick silently costs the whole run.
+                val victimCandidates = RestIndividualSelectorUtils.findAndSlice(
+                    individualsInSolution, verb, op.path,
+                    statusGroup = StatusGroup.G_2xx, authenticated = true
+                ).sortedBy { it.size() }
+                    .distinctBy { it.seeMainExecutableActions().last().auth.name }
+
+                for (victimSlice in victimCandidates) {
+                    if (hasPhaseTimedOut()) return
+                    if (statefulTripleAttempts >= maxStatefulAttempts) return
+                    // stop this endpoint at the first VALID triple: further attempts would reduce yet
+                    // more privileges, polluting the state for the endpoints still to be tried
+                    if (buildStatefulAuthzTriple(victimSlice, transition, reducedRoleCandidates, declared)) break
+                }
+            }
+        }
+    }
+
+    /**
+     * Try to obtain ONE conclusive MR-A1 triple for this victim, retrying over the possible operators.
+     *
+     * @return true if a VALID triple was executed, ie the attempt produced a verdict -- whatever that
+     * verdict is. False means every attempt was VOID under §5.3 and the caller should move on to
+     * another victim candidate.
+     */
+    private fun buildStatefulAuthzTriple(
+        victimSlice: RestIndividual,
+        transitionDef: RestCallAction,
+        reducedRoleCandidates: List<String>,
+        declared: DeclaredTransition?
+    ): Boolean {
+        val victimAuth = victimSlice.seeMainExecutableActions().lastOrNull()?.auth ?: return false
+        if (victimAuth is NoAuth) return false
+
+        // Reset the SUT BEFORE the candidate lists below are built, not only from inside an attempt.
+        //
+        // [privilegeReducedInPhase] records the demotions this phase performed, and a successful reset
+        // undoes every one of them and clears it. But if the reset is only ever reached from inside
+        // [executeStatefulAuthzTriple], then giving a victim up WITHOUT making a further attempt leaves
+        // the PREVIOUS victim marked -- and that user may be the only one still able to PERFORM the
+        // transition for every victim after it, so the run ends empty even though a valid triple was
+        // available. Resetting here makes both lists below agree with the state the attempt will
+        // actually run against, instead of with a state two attempts ago.
+        //
+        // No-op unless a reset endpoint was configured, so the default black-box path is unchanged.
+        resetSutState()
+
+        // nothing left to take away from a victim this phase already demoted, and the source would be
+        // denied -- which in black-box kills the test before the transition is even sent
+        if (privilegeReducedInPhase.contains(victimAuth.name)) return false
+
+        // DIFFERENT, still-privileged users to perform the transition; prefer any seen doing it (2xx),
+        // and never one we demoted ourselves, whose transition could only come back 403
+        val operators = authSettings.getAllOthers(victimAuth.name, HttpWsAuthenticationInfo::class.java)
+            .filter { !privilegeReducedInPhase.contains(it.name) }
+            .sortedByDescending { o ->
+                RestIndividualSelectorUtils.findIndividuals(
+                    individualsInSolution, transitionDef.verb, transitionDef.path,
+                    statusGroup = StatusGroup.G_2xx, authenticatedWith = o.name
+                ).isNotEmpty()
+            }
+
+        // Operator is the OUTER loop and the proposed role value the INNER one, because the two fail
+        // for unrelated reasons and only one of them is worth re-trying in place:
+        //
+        //   value never sent (the schema would not accept it, eg "viewer" into `role: integer`)
+        //       -> nothing was done to the SUT; try the NEXT VALUE
+        //   value sent, transition rejected (403: this operator is not privileged either)
+        //       -> no value can repair that; try the NEXT OPERATOR
+        //   value sent, transition accepted (2xx)
+        //       -> the victim's privilege is spent, and a second transition on an already-reduced
+        //          account could only look like one that did nothing; give this victim up
+        //
+        // The distinction is read off [statefulTripleAttempts], which counts only triples actually
+        // put to the SUT, and off [privilegeReducedInPhase], which records transitions that landed.
+        for (operator in operators) {
+            for (reducedRole in reducedRoleCandidates) {
+                if (hasPhaseTimedOut()) return false
+                if (statefulTripleAttempts >= maxStatefulAttempts) return false
+
+                val before = statefulTripleAttempts
+                if (executeStatefulAuthzTriple(victimSlice, transitionDef, reducedRole, operator, declared)) {
+                    return true
+                }
+                if (statefulTripleAttempts == before) {
+                    continue        // not sent at all: this value did not fit the schema
+                }
+                if (privilegeReducedInPhase.contains(victimAuth.name)) {
+                    return false    // the transition landed; the victim is spent
+                }
+                break               // the transition was rejected: change operator, not value
+            }
+        }
+        return false
+    }
+
+    /**
+     * Build and run one [source -> transition -> follow-up] attempt with the given operator.
+     * @return true if the triple was conclusive (§5.3), false if VOID.
+     */
+    private fun executeStatefulAuthzTriple(
+        victimSlice: RestIndividual,
+        transitionDef: RestCallAction,
+        reducedRole: String,
+        operator: HttpWsAuthenticationInfo,
+        declared: DeclaredTransition?
+    ): Boolean {
+        val base = victimSlice.copy() as RestIndividual
+        val source = base.seeMainExecutableActions().lastOrNull() ?: return false
+        val victimAuth = source.auth
+        if (victimAuth is NoAuth) return false
+
+        // --- transition: reduce the victim's role, performed by the operator ---
+        val transition = transitionDef.copy() as RestCallAction
+        transition.resetLocalIdRecursively()
+        transition.forceNewTaints()
+        transition.doInitialize(randomness)
+        transition.auth = operator
+        // target the victim, and set a reduced role; either failing => void
+        if (declared != null) {
+            // Bind by the names the user declared, rather than by inferred signals.
+            if (!applyDeclaredBindings(transition, declared, victimAuth.name, operator.name)) {
+                log.debug("Stateful-authorization: could not apply declared bindings" +
+                        " ${declared.bindings} on ${transition.getName()}")
+                return false
+            }
+        } else {
+            if (!setUserTargetToVictim(transition, victimAuth.name)) {
+                log.debug("Stateful-authorization: could not target victim '${victimAuth.name}' on ${transition.getName()}")
+                return false
+            }
+            if (!setRoleFieldToReduced(transition, reducedRole)) {
+                log.debug("Stateful-authorization: could not set reduced role '$reducedRole' on ${transition.getName()}")
+                return false
+            }
+        }
+        base.addMainActionInEmptyEnterpriseGroup(action = transition)
+
+        // --- follow-up: replay the guarded action, SAME credential, same resource ---
+        val followUp = source.copy() as RestCallAction
+        followUp.resetLocalIdRecursively()
+        followUp.forceNewTaints()
+        followUp.auth = victimAuth
+        followUp.usePreviousLocationId = source.usePreviousLocationId
+        followUp.bindBasedOn(source.path, source.parameters.filterIsInstance<PathParam>(), null)
+        base.addMainActionInEmptyEnterpriseGroup(action = followUp)
+
+        base.doInitializeLocalId()
+        base.modifySampleType(SampleType.SECURITY)
+        base.ensureFlattenedStructure()
+        base.fixResourceForwardLinks()
+        org.evomaster.core.Lazy.assert { base.verifyValidity(); true }
+
+        // THESIS EXTENSION (ablation). Everything above only builds the individual in memory; the SUT
+        // is first touched by the fitness call below, so this is the last possible moment to reset.
+        resetSutState()
+
+        // fitness runs the JUDGMENT handler; the test is kept only if it revealed a new (fault) target
+        val ei = fitness.computeWholeAchievedCoverageForPostProcessing(base)
+        if (ei == null) {
+            log.warn("Failed to evaluate constructed stateful-authorization individual")
+            return false
+        }
+        statefulTripleAttempts++
+
+        // What the SUT actually did, looked up per action rather than by position: black-box stops a
+        // test at its first failing resource-creating call, so an action can have NO result at all.
+        fun statusOf(a: RestCallAction): Int? =
+            (ei.seeResult(a.getLocalId()) as? RestCallResult)?.getStatusCode()
+        val sourceCode = statusOf(source)
+        val transitionCode = statusOf(transition)
+        val followUpCode = statusOf(followUp)
+        val observed = listOf(sourceCode, transitionCode, followUpCode)
+            .joinToString("/") { it?.toString() ?: "-" }
+
+        // Whether the transition landed decides who is still privileged for the attempts after this
+        // one, and it is true even when the triple as a whole turns out void.
+        if (transitionCode != null && StatusGroup.G_2xx.isInGroup(transitionCode)) {
+            privilegeReducedInPhase.add(victimAuth.name)
+        }
+
+        // VALIDITY (§5.3). The privilege must have demonstrably worked (source 2xx), the transition
+        // must have taken effect (2xx), and the follow-up must be conclusive -- 401 means the token
+        // was invalid or expired, which is INCONCLUSIVE and must never be read as a verdict. Anything
+        // else is not a result at all, and the caller retries with another candidate.
+        val valid = sourceCode != null && StatusGroup.G_2xx.isInGroup(sourceCode)
+            && transitionCode != null && StatusGroup.G_2xx.isInGroup(transitionCode)
+            && followUpCode != null && followUpCode != 401
+
+        if (!valid) {
+            LoggingUtil.getInfoLogger().info(
+                "Discarded a VOID stateful-authorization (MR-A1) attempt on ${source.getName()}" +
+                    " (victim '${victimAuth.name}', operator '${operator.name}', codes $observed)"
+            )
+            return false
+        }
+
+        // The follow-up was ALLOWED, so this is exactly the branch on which a 970 would be raised.
+        // Confirm the premise by OBSERVATION before letting that happen (see the probe's own doc).
+        // Deliberately not run when the follow-up was denied: the probe can only ever WITHHOLD a
+        // fault, never manufacture one, so it cannot disturb a triple that already passes.
+        if (StatusGroup.G_2xx.isInGroup(followUpCode!!)
+            && !reLoginProbeConfirmsPrivilegeRemoved(victimSlice)) {
+            LoggingUtil.getInfoLogger().info(
+                "Discarded an UNCONFIRMED stateful-authorization (MR-A1) attempt on ${source.getName()}:" +
+                    " re-logging the victim in did not show the privilege removed" +
+                    " (victim '${victimAuth.name}', operator '${operator.name}', codes $observed)"
+            )
+            return false
+        }
+
+        // A conclusive triple was performed. Logged UNCONDITIONALLY, before any verdict, so that
+        // construction (this line) and judgment (the line below) are counted separately: a true
+        // negative means something only for a run that actually put a valid triple to the SUT.
+        // The three statuses ARE the triple [source / transition / follow-up].
+        LoggingUtil.getInfoLogger().info(
+            "Assembled a stateful-authorization (MR-A1) triple on ${source.getName()}" +
+                " (victim '${victimAuth.name}', operator '${operator.name}'," +
+                " transition ${transition.getName()}, statuses $observed)"
+        )
+        if (ExperimentalFaultCategory.SECURITY_STATEFUL_AUTHORIZATION in DetectedFaultUtils.getDetectedFaultCategories(ei)) {
+            LoggingUtil.getInfoLogger().info(
+                "Constructed a stateful-authorization (MR-A1) test revealing privilege persistence" +
+                    " after a role downgrade on ${source.getName()} (victim '${victimAuth.name}')"
+            )
+        }
+        archive.addIfNeeded(ei)
+        return true
+    }
