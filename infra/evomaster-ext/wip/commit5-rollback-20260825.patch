+    /**
+     * Re-login probe: establish BY OBSERVATION -- rather than by guessing from the schema -- both
+     * that the transition really removed a privilege and that the guarded action really is gated by
+     * the privilege that was removed. The victim logs in AGAIN and re-attempts the same action with
+     * the FRESH credential:
+     *
+     *   fresh DENIED (403) -> the privilege is gone, AND this action is gated by it => premise holds
+     *   fresh ALLOWED      -> either nothing was taken away, or this action is gated by something
+     *                         else entirely (ownership, say, rather than role)      => VOID
+     *   anything else (eg 401: the victim can no longer log in at all)              => INCONCLUSIVE
+     *
+     * IT IS NOT CIRCULAR. The oracle asks what the OLD credential can still do; the probe asks what a
+     * NEW one can do. They are different questions, and on a vulnerable SUT they have different
+     * answers -- which is the whole point: this bug class exists precisely because privileges are
+     * snapshotted into the credential when it is issued, so a credential issued AFTER the transition
+     * always reflects the CURRENT state, on a vulnerable and a fixed target alike.
+     *
+     * What it buys: the three schema heuristics upstream (which endpoint is a transition, which value
+     * is the lesser role, which action is privilege-gated) all GUESS, and a wrong guess used to be
+     * discoverable only as a false positive. The probe converts each of them into a claim the SUT
+     * itself has to confirm.
+     *
+     * The fresh login costs nothing to arrange: BlackBoxRestFitness re-runs AuthUtils.getTokens and
+     * getCookies for EVERY individual it evaluates, so running the probe as its OWN individual
+     * re-authenticates the victim without touching the auth layer at all.
+     */
+    private fun reLoginProbeConfirmsPrivilegeRemoved(victimSlice: RestIndividual): Boolean {
+
+        val probe = victimSlice.copy() as RestIndividual
+        probe.modifySampleType(SampleType.SECURITY)
+        val ei = fitness.computeWholeAchievedCoverageForPostProcessing(probe) ?: return false
+
+        // READ THE LAST ACTION THAT ACTUALLY RAN, not the guard by position. The slice usually opens
+        // with a setup call that is itself privileged -- creating the resource the guard then acts on
+        // -- and black-box ABORTS a test at its first failing resource-creating call. So on a victim
+        // who really was demoted, the freshly logged-in probe is typically denied at the SETUP call
+        // and the guard never runs at all, leaving it with no result. Insisting on a status for the
+        // guard would read that as "not confirmed" and throw away a genuine detection, even though
+        // being denied earlier in the same chain is if anything STRONGER evidence: the privilege is
+        // gone at the first place it is needed.
+        val lastObserved = probe.seeMainExecutableActions()
+            .mapNotNull { (ei.seeResult(it.getLocalId()) as? RestCallResult)?.getStatusCode() }
+            .lastOrNull()
+            ?: return false
+
+        // 403 = denied under a CURRENT credential => the privilege really was removed, and this chain
+        // really does need it. Anything else -- 2xx (still allowed), 401 (cannot log in at all, so
+        // INCONCLUSIVE per §5.3), 404 (resource gone) -- does not establish the premise.
+        return lastObserved == 403
+    }
+
+    /**
+     * Recognise a permission-reducing transition endpoint: a write whose path/name carries a
+     * role/permission signal AND that exposes a user-identifying parameter (so we can target a victim).
+     * Scoped to role-change endpoints per §5.3; broader signal inference is future work.
+     */
+    private fun findPermissionReducingTransition(): RestCallAction? {
+        val preferredOrder = listOf(HttpVerb.PUT, HttpVerb.PATCH, HttpVerb.POST, HttpVerb.DELETE)
+        return actionDefinitions
+            .filter { it.verb in preferredOrder }
+            .sortedBy { preferredOrder.indexOf(it.verb) }
+            .firstOrNull { a ->
+                val hay = (a.path.toString() + " " + a.getName()).lowercase()
+                val pathSignal = transitionPathSignals.any { hay.contains(it) }
+                val hasUserParam = allGenes(a).any { g ->
+                    val n = g.name.lowercase()
+                    transitionUserParamSignals.any { n == it || n.contains(it) }
+                }
+                pathSignal && hasUserParam
+            }
+    }
+
+    /**
+     * Values to try in the transition's role field, best first.
+     *
+     * This used to DECIDE a single value, harvested from the schema's enum vocabulary by a
+     * low-privilege naming signal. That works only where the schema names its roles: an API that
+     * declares `role: integer` offers no vocabulary at all, and the whole oracle was skipped there
+     * even though the transition endpoint had been recognised correctly. So this now PROPOSES, and
+     * the re-login probe (see [reLoginProbeConfirmsPrivilegeRemoved]) is what establishes whether a
+     * proposal actually removed a privilege -- an observation about the SUT rather than a guess
+     * about its schema.
+     *
+     * ORDER IS LOAD-BEARING. Without a configured reset endpoint the transition can realistically be
+     * applied ONCE per victim, so in practice only the first candidate is tried. The enum match
+     * therefore stays first, which leaves the behaviour that produced every measured Tier-1/Tier-2
+     * number exactly as it was.
+     */
+    private fun harvestReducedRoleCandidates(transition: RestCallAction): List<String> {
+
+        val enumVocab = (allGenes(transition) + actionDefinitions.flatMap { allGenes(it) })
+            .filterIsInstance<EnumGene<*>>()
+            .flatMap { it.values.map { v -> v.toString() } }
+            .distinct()
+
+        val lowPrivEnum = enumVocab.filter { v ->
+            val lv = v.lowercase()
+            roleLowPrivSignals.any { lv.contains(it) } && roleHighPrivSignals.none { lv.contains(it) }
+        }
+
+        // What the role field on THIS transition actually is decides which untyped fallbacks make
+        // sense: numbers for a numeric field, role-ish words for a string one.
+        val roleGenes = allGenes(transition).filter { g ->
+            val n = g.name.lowercase()
+            roleFieldSignals.any { n == it || n.contains(it) }
+        }
+        val numeric = if (roleGenes.any { it is IntegerGene || it is LongGene }) numericRoleCandidates else emptyList()
+        val strings = if (roleGenes.any { it is StringGene }) stringRoleCandidates else emptyList()
+
+        return (lowPrivEnum + numeric + (enumVocab - lowPrivEnum.toSet()) + strings).distinct()
+    }
+
+    private fun allGenes(action: RestCallAction): List<Gene> =
+        action.seeTopGenes().flatMap { it.flatView() }
+
+    /**
+     * Bind the victim's identity on the transition. A role-change endpoint identifies the target user
+     * via a PATH parameter (eg /users/{username}/role) or a BODY field; an RPC-style API instead puts
+     * it in the QUERY STRING (eg POST /api/set_user_permission?user=..), and matching only path and
+     * body made every such transition unbindable and so unusable.
+     *
+     * Query params are matched LAST and only at their TOP LEVEL -- see [setInQueryParamsTopLevel].
+     */
+    private fun setUserTargetToVictim(action: RestCallAction, victimName: String): Boolean =
+        setInParams(action.parameters.filterIsInstance<PathParam>(), transitionUserParamSignals, victimName)
+            || setInParams(action.parameters.filterIsInstance<BodyParam>(), transitionUserParamSignals, victimName)
+            || setInQueryParamsTopLevel(action, transitionUserParamSignals, victimName)
+
+    /**
+     * Set the reduced role on the transition's BODY, falling back to a top-level QUERY parameter.
+     */
+    private fun setRoleFieldToReduced(action: RestCallAction, reducedRole: String): Boolean =
+        setInParams(action.parameters.filterIsInstance<BodyParam>(), roleFieldSignals, reducedRole)
+            || setInQueryParamsTopLevel(action, roleFieldSignals, reducedRole)
+
+    /**
+     * Match a QUERY parameter by its own name only, never a field nested inside one.
+     *
+     * The restriction is not cosmetic. Tier-1 is served by springdoc, which wrongly publishes the
+     * controller's internal `CurrentUser` argument as a `caller` query parameter carrying nested
+     * `username` and `role` fields that the application completely ignores. A blanket search over
+     * nested query genes would happily bind the transition into `caller.role`, get a 200 back, and
+     * record a transition that demoted nobody -- manufacturing precisely the situation §5.3's
+     * validity conditions exist to exclude, and turning a false negative into a FALSE POSITIVE.
+     * A real RPC-style parameter is flat (`?user=x&role=1`), so nothing legitimate is lost.
+     *
+     * This fallback is unreachable on both seeded targets, where the path/body binding above already
+     * succeeds; it exists for APIs that offer no path or body parameter at all.
+     */
+    private fun setInQueryParamsTopLevel(
+        action: RestCallAction,
+        signals: List<String>,
+        value: String
+    ): Boolean {
+        for (p in action.parameters.filterIsInstance<QueryParam>()) {
+            val n = p.name.lowercase()
+            if (signals.any { n == it || n.contains(it) } && p.primaryGene().setFromStringValue(value)) {
+                return true
+            }
+        }
+        return false
+    }
+
+    /**
+     * How many DISTINCT authenticated users were ever observed getting the given outcome on this
+     * endpoint. Used to rank guard candidates: an admin-only action has few users allowed and many
+     * denied, an action open to every role has the opposite profile.
+     */
+    private fun distinctUsersOn(
+        verb: HttpVerb,
+        path: RestPath,
+        statusGroup: StatusGroup? = null,
+        status: Int? = null
+    ): Int =
+        RestIndividualSelectorUtils.findAndSlice(
+            individualsInSolution, verb, path,
+            status = status, statusGroup = statusGroup, authenticated = true
+        ).mapNotNull { it.seeMainExecutableActions().lastOrNull()?.auth?.name }
+            .distinct()
+            .size
+
+    /**
+     * Apply a declared transition's bindings to the action, resolving the <victim> and <operator>
+     * placeholders for this attempt. Unlike the inferred path, names are matched EXACTLY: the user
+     * said which parameter carries what, so guessing on top of that would only hide their mistakes.
+     *
+     * All bindings must succeed. A partially aimed transition is worse than none: it would still be
+     * sent, could still return 2xx, and would then be counted as a transition that never actually
+     * demoted the victim -- manufacturing the one thing §5.3's validity conditions exist to exclude.
+     */
+    private fun applyDeclaredBindings(
+        action: RestCallAction,
+        declared: DeclaredTransition,
+        victimName: String,
+        operatorName: String
+    ): Boolean {
+        if (declared.bindings.isEmpty()) {
+            return true
+        }
+        return declared.bindings.all { (name, raw) ->
+            val value = raw
+                .replace("<victim>", victimName)
+                .replace("<operator>", operatorName)
+            allGenes(action).any { g ->
+                g.name.equals(name, ignoreCase = true) && g.setFromStringValue(value)
+            }
+        }
+    }
+
+    private fun setInParams(params: List<Param>, signals: List<String>, value: String): Boolean {
+        for (p in params) {
+            for (g in p.primaryGene().flatView()) {
+                val n = g.name.lowercase()
+                if (signals.any { n == it || n.contains(it) } && g.setFromStringValue(value)) {
+                    return true
+                }
+            }
+        }
+        return false
+    }
