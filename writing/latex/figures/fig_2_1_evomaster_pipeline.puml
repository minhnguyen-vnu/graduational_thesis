@startuml
skinparam dpi 300
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 11
skinparam roundcorner 4
skinparam rectangleBorderThickness 1.2
skinparam databaseBorderThickness 1.2
skinparam arrowThickness 1.2

package "Pha 1: Tìm kiếm tiến hóa (EvoMaster gốc)" as search_phase {
  file "Đặc tả OpenAPI" as spec
  component "Giải thuật MIO" as mio
  component "Bộ thực thi HTTP\n& đo độ phủ" as exec
  database "Kho lưu trữ\nca kiểm thử" as store
  
  spec -right-> mio
  mio -right-> exec : Đánh giá độ phủ
  exec -right-> store : Lưu ca kiểm thử
}

node "Hệ thống API mục tiêu (SUT)" as sut

package "Pha 2: Kiểm thử bảo mật (Phần mở rộng)" as sec_phase {
  component "Bộ cấu hình\n& ngân sách" as config
  component "Bộ dựng kịch bản\nMR-A1" as builder
  component "Bộ phán quyết\n(Oracle 970)" as oracle
  file "Bộ ca kiểm thử\n(JUnit / Python)" as tests
  file "Cảnh báo lỗ hổng\nOracle 970" as alert

  config -down-> builder : Tham số
  builder -right-> oracle : Kịch bản bộ ba
  builder -down-> tests : Xuất ca kiểm thử
  oracle -down-> alert : Vi phạm MR-A1
}

exec <--> sut : Tương tác HTTP
store -down-> builder : Ca kiểm thử\nhạt giống
builder .left.> sut : Gửi bộ ba HTTP

@enduml
